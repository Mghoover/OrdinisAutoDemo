---
import DetailLayout from "../../layouts/DetailLayout.astro";
import { services, bySlug } from "../../data/automotive";

export function getStaticPaths() {
  return services.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const item = bySlug(services, Astro.params.slug) ?? Astro.props.item;
---

<DetailLayout item={item} parentLabel="Services" parentPath="/services/" />
